+/* RX batching: multiply the SuperSpeed RX queue depth so a larger
+ * rx_urb_size still keeps many URBs in flight (usbnet caps total ring bytes,
+ * so a big buffer alone starves the pipe). 1 = stock. */
+static unsigned int rx_qlen_mult = 8;
+module_param(rx_qlen_mult, uint, 0644);
+MODULE_PARM_DESC(rx_qlen_mult, "Multiply SuperSpeed RX queue depth (default 8, 1=stock)");
+
 // reawaken network queue this soon after stopping; else watchdog barks
