#!/bin/sh
# Have fw4 run /etc/fw4-eth1-flowtable.sh after every (re)load, so the 5G
# modem netdev joins the software flowtable (fw4 leaves it out for proto xmm).
uci -q show firewall | grep -q "path='/etc/fw4-eth1-flowtable.sh'" && exit 0
S=$(uci add firewall include)
uci set firewall.$S.type='script'
uci set firewall.$S.path='/etc/fw4-eth1-flowtable.sh'
uci commit firewall
exit 0
